# Install as /etc/t3-slack/slack.env with owner root:root and mode 0600.
SLACK_APP_TOKEN=xapp-replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
T3_HTTP_URL=http://127.0.0.1:3773
T3_PUBLIC_URL=https://t3.example.com
T3_PROJECT_ID=replace-with-project-id
SLACK_CONVERSATION_AUDIT_LOG_FILE=/var/lib/t3-slack/conversation-starts.jsonl
# Optional complete ModelSelection JSON. Omit to use the project's default.
# T3_MODEL_SELECTION={"instanceId":"codex","model":"gpt-5","options":[]}
SLACK_HEALTH_HOST=127.0.0.1
SLACK_HEALTH_PORT=3210
T3_CREDENTIAL_EXPIRY_WARNING_DAYS=10
