# Install as /etc/t3-slack/rotation.env with owner root:root and mode 0600.
T3_HTTP_URL=http://127.0.0.1:3773
T3_BEARER_CREDENTIAL_FILE=/etc/t3-slack/secrets/t3-daemon.token
T3_ROTATOR_CREDENTIAL_FILE=/etc/t3-slack/secrets/t3-rotator.token
T3_DAEMON_CREDENTIAL_LABEL=t3-slack-daemon
T3_ROTATOR_CREDENTIAL_LABEL=t3-slack-rotator
T3_CREDENTIAL_ROTATE_BEFORE_DAYS=10
SLACK_SYSTEMD_SERVICE=t3-slack.service
SLACK_READY_URL=http://127.0.0.1:3210/ready
SLACK_ROTATION_REQUEST_TIMEOUT_MS=10000
SLACK_ROTATION_READY_TIMEOUT_MS=60000
