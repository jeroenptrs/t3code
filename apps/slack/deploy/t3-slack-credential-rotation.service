[Unit]
Description=Rotate T3 Code Slack ingress credentials
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/t3-code
EnvironmentFile=/etc/t3-slack/rotation.env
ExecStart=/usr/bin/env node --experimental-strip-types apps/slack/src/rotateCredentialMain.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/t3-slack/secrets
